{
  "name": "@mantle/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "End-to-end regression net for the server/client split \u2014 runs against a live stack, parameterized same-origin vs split topology.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:same": "playwright test --project=same-origin",
    "e2e:split": "playwright test --project=split",
    "e2e:workspace": "playwright test -c playwright.workspace.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@mantle/client-types": "npm:@crossworks/client-types@0.400.14",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3"
  }
}
