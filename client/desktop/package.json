{
  "name": "@mantle/client-desktop",
  "version": "0.8.3",
  "private": true,
  "productName": "Jackdaw",
  "homepage": "https://github.com/crossworks-engineering/mantle-client",
  "author": "Jason Schoeman <jason@schoeman.me>",
  "description": "MantleOS Desktop: an Electron shell around the owner UI. A native client alongside MantleOS mobile: connect screen picks a brain, bearer auth, no server secrets in the app.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:ui": "bash scripts/build-ui.sh",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:ci": "electron-vite build && electron-builder --publish always",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
