{
  "name": "mantle-client",
  "version": "0.8.8",
  "private": true,
  "description": "MantleOS Desktop: the web + desktop interface for MantleOS brains.",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -C client/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"{client,packages,e2e,scripts}/**/*.{ts,tsx,mjs,cjs}\" \"*.{ts,tsx,mjs,cjs}\"",
    "format:check": "prettier --check \"{client,packages,e2e,scripts}/**/*.{ts,tsx,mjs,cjs}\" \"*.{ts,tsx,mjs,cjs}\"",
    "test": "vitest run",
    "verify": "pnpm -r typecheck && pnpm lint && pnpm format:check && vitest run",
    "themes:pull": "echo 'themes are generated in the mantle repo (packages/share-ui) and consumed from @crossworks/share-ui'",
    "dev:fe": "scripts/dev-frontend.sh",
    "version:bump": "node scripts/bump-version.mjs",
    "e2e": "e2e/scripts/run-local.sh",
    "e2e:up": "e2e/scripts/run-local.sh up",
    "e2e:test": "e2e/scripts/run-local.sh test",
    "e2e:down": "e2e/scripts/run-local.sh down",
    "e2e:routes": "node e2e/check-routes.mjs",
    "e2e:workspace": "pnpm -C e2e e2e:workspace"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "~16.3.8",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
